-- ~/.config/hypr/modules/monitors.lua
--===========================
-- MONITORS
--===========================
local scale = 1

-- physical px -> logical px (by scale)
local function pos(x, y)
    return string.format("%dx%d", math.floor(x / scale + 0.5), math.floor(y / scale + 0.5))
end

-- List order sets workspaces: monitor k owns k, k+N, k+2N, ... (N = #monitors)
local monitors = {
    {
        output = "HDMI-A-1",
        mode = "1920x1080", position = pos(0, 0),
        scale = scale,
        transform = 1
    },
    {
        output = "DP-3",
        mode = "1920x1080",
        position = pos(1080, 460),
        scale = scale
    },
}

-- Set up each monitor and pin its workspaces to it
local per = math.ceil(WORKSPACES / #monitors)
for k, m in ipairs(monitors) do
    hl.monitor(m)
    for i = 0, per - 1 do
        hl.workspace_rule({ workspace = tostring(k + i * #monitors), monitor = m.output, default = (i == 0) })
    end
end

